{
  "name": "@particular-labs/codestory",
  "version": "0.2.0",
  "description": "Living storyboards for codebases — boards chain flows end-to-end, agents maintain them, a local viewer presents them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/particular-labs/codestory.git"
  },
  "keywords": [
    "storyboard",
    "documentation",
    "diagram",
    "flowchart",
    "codebase",
    "cli",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codestory": "./dist/cli.js"
  },
  "files": ["dist", "viewer/dist"],
  "scripts": {
    "test": "bun test",
    "build": "bun build src/cli.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "build:viewer": "cd viewer && bun install && bun run build",
    "prepublishOnly": "bun run build && bun run build:viewer",
    "cli": "bun run src/cli.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "citty": "^0.2.2",
    "hono": "^4.12.27",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
