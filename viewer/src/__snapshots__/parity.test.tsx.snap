-size: 9px; font-weight: 700; line-height: 14px; text-align: center; padding: 0px 3px; font-family: &quot;JetBrains Mono&quot;, monospace;">1</span></button><button data-tip="Flow: horizontal — switch to vertical" style="width: 30px; height: 30px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); font-size: 13px; display: flex; align-items: center; justify-content: center; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="m8 3-4 4 4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg></button><button data-tip="Copy link to this view" style="width: 30px; height: 30px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); font-size: 13px; display: flex; align-items: center; justify-content: center; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button><button data-tip="Export view as PNG" style="position: relative; width: 30px; height: 30px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); font-size: 13px; display: flex; align-items: center; justify-content: center; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" st