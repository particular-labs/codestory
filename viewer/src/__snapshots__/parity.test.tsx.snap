: flex; align-items: center; gap: 10px;"><div style="display: flex; align-items: center; gap: 6px; flex-grow: 0; flex-shrink: 0; flex-basis: auto;"><button data-tip="Previous step" data-tip-pos="up" data-tip-align="left" style="width: 32px; height: 32px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); display: flex; align-items: center; justify-content: center; opacity: 1; cursor: pointer; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button><button data-tip="Next step" data-tip-pos="up" data-tip-align="left" style="width: 32px; height: 32px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); display: flex; align-items: center; justify-content: center; opacity: 1; cursor: pointer; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div><div style="font-family: &quot;JetBrains Mono&quot;, monospace; font-size: 10.5px; color: var(--mute); width: 48px; flex-grow: 0; flex-shrink: 0; flex-basis: auto;">4 / 6</div><div style="height: 4px; border-radius: 3px; background: var(--inset); overflow: hidden; flex-grow: 1; flex-shrink: 1; flex-basis: auto;"><div style="width: 67%; height: 100%; background: var(--accent); border-radius: 3px; transition: width 220ms ease;"></div></div><button data-tip="Show step detail" data-tip-pos="up" style="border-radius: 7px; border: 1px solid; bac