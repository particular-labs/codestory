exports[`parity: narrow viewport (mobile layout) 1`] = `"<div style="--bg: #0e0f13; --surface: #15171d; --surface2: #1c1f27; --inset: #101217; --border: #282c36; --borderStrong: #3a3f4c; --fg: #e7e9f0; --dim: #a2a8b8; --mute: #6a7080; --accent: #7c8cff; --accentFg: #ffffff; --accentSoft: rgba(124,140,255,0.15); --grid: #1b1e26; --edge: #3a3f4c; --planned: #7a8194; --built: #3ecf8e; --drifted: #e0a341; --shadow: 0 6px 22px rgba(0,0,0,0.4); --overlay: rgba(14,15,19,0.7); background: var(--bg); color: var(--fg); height: 100vh; width: 100%; display: flex; flex-direction: column; overflow: hidden; position: relative; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;"><div style="height: 52px; display: flex; align-items: center; background: var(--surface); z-index: 20; gap: 8px; padding: 0px 10px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; border-bottom-width: var(--border); border-bottom-style: var(--border); border-bottom-color: var(--border);"><button data-tip="Menu" data-tip-align="left" style="width: 30px; height: 30px; border-radius: 7px; border: 1px solid; background: var(--inset); color: var(--dim); font-size: 15px; display: flex; align-items: center; justify-content: center; flex-grow: 0; flex-shrink: 0; flex-basis: auto; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg></button><div style="display: flex; align-items: center; gap: 9px; flex-grow: 0; flex-shrink: 0; flex-basis: auto;"><div style="width: 15px; height: 15px; border-radius: 4px; background: var(--accent); box-shadow: 0 0 0 3px var(--accentSoft);"></div><span style="font-size: 1