exports[`parity: notes hub open 1`] = `"<div style="--bg: #0e0f13; --surface: #15171d; --surface2: #1c1f27; --inset: #101217; --border: #282c36; --borderStrong: #3a3f4c; --fg: #e7e9f0; --dim: #a2a8b8; --mute: #6a7080; --accent: #7c8cff; --accentFg: #ffffff; --accentSoft: rgba(124,140,255,0.15); --grid: #1b1e26; --edge: #3a3f4c; --planned: #7a8194; --built: #3ecf8e; --drifted: #e0a341; --shadow: 0 6px 22px rgba(0,0,0,0.4); --overlay: rgba(14,15,19,0.7); background: var(--bg); color: var(--fg); height: 100vh; width: 100%; display: flex; flex-direction: column; overflow: hidden; position: relative; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;"><div style="height: 52px; display: flex; align-items: center; background: var(--surface); z-index: 20; gap: 16px; padding: 0px 16px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; border-bottom-width: var(--border); border-bottom-style: var(--border); border-bottom-color: var(--border);"><div style="display: flex; align-items: center; gap: 9px; flex-grow: 0; flex-shrink: 0; flex-basis: auto;"><div style="width: 15px; height: 15px; border-radius: 4px; background: var(--accent); box-shadow: 0 0 0 3px var(--accentSoft);"></div><span style="font-size: 14px; font-weight: 650; letter-spacing: -0.01em;">codestory</span><span style="font-family: &quot;JetBrains Mono&quot;, monospace; font-size: 10.5px; color: var(--mute); background: var(--inset); border: 1px solid; padding: 2px 7px; border-radius: 5px; border-width: var(--border); border-style: var(--border); border-color: var(--border);">Fixture</span></div><div style="min-width: 0; display: flex; justify-content: center; overflow: hidden; flex-grow: 1; flex-shrink: 1; flex-basis: auto;"><div style="display: flex; align-items: center; gap: 2px; font-size: 12.5px; min-width: 0; overflow: hidden; white-space: nowrap;"><button style="border: none none; background: none none; padding: 3px 6px; border-radius: 5px; colo