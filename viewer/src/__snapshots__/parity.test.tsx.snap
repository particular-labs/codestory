dth="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></button></div></div><div style="display: flex; flex-direction: column; gap: 5px; padding: 8px 9px; border-radius: 8px; border: 1px solid; background: var(--inset); opacity: 0.55; border-width: var(--border); border-style: var(--border); border-color: var(--border);"><div style="display: flex; align-items: center; gap: 7px;"><button title="Go to step" style="border: none none; background: none none; padding: 0px; font-family: &quot;JetBrains Mono&quot;, monospace; font-size: 10px; color: var(--accent); cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Account</button><span style="color: var(--built); border: 1px solid; background: transparent; border-radius: 5px; padding: 2px 7px; font-size: 9.5px; font-weight: 600; font-family: &quot;JetBrains Mono&quot;, monospace; letter-spacing: 0.02em; margin-left: auto; border-width: var(--built); border-style: var(--built); border-color: var(--built); flex-grow: 0; flex-shrink: 0; flex-basis: auto;">applied</span></div><div style="font-size: 12px; line-height: 1.45; color: var(--fg); text-decoration: line-through;">journey-level note</div><div style="display: flex; gap: 6px; justify-content: flex-end;"><button data-tip="Delete note" data-tip-pos="up" style="height: 22px; padding: 0px 8px; border-radius: 5px; border: 1px solid; background: transparent; color: var(--dim); font-size: 10.5px; font-weight: 600; cursor: pointer; border-width: var(--borderStrong); border-style: var(--borderStrong); border-color: var(--borderStrong);"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-line